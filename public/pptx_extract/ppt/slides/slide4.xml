-120"/></a:rPr><a:t>A repair shop that went a month</a:t></a:r><a:endParaRPr lang="en-US" sz="2500" dirty="0"/></a:p><a:p><a:pPr marL="0" indent="0"><a:lnSpc><a:spcPts val="3200"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="2500" dirty="0"><a:solidFill><a:srgbClr val="2B3138"/></a:solidFill><a:latin typeface="Georgia" pitchFamily="34" charset="0"/><a:ea typeface="Georgia" pitchFamily="34" charset="-122"/><a:cs typeface="Georgia" pitchFamily="34" charset="-120"/></a:rPr><a:t>without a single call</a:t></a:r><a:endParaRPr lang="en-US" sz="2500" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="4" name="Text 2"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="713232" y="2148840"/><a:ext cx="5029200" cy="2926080"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr marL="0" indent="0"><a:lnSpc><a:spcPts val="1863"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1150" dirty="0"><a:solidFill><a:srgbClr val="555D66"/></a:solidFill><a:latin typeface="Arial" pitchFamily="34" charset="0"/><a:ea typeface="Arial" pitchFamily="34" charset="-122"/><a:cs typeface="Arial" pitchFamily="34" charset="-120"/></a:rPr><a:t>PC Technologies sells and repairs computers in Portland. The Google Ads account was live and spending, but the phone had not rung once in a month.</a:t></a:r><a:endParaRPr lang="en-US" sz="1150" dirty="0"/></a:p><a:p><a:pPr marL="0" indent="0"><a:lnSpc><a:spcPts val="1863"/></a:lnSpc><a:buNone/></a:pPr><a:endParaRPr lang="en-US" sz="1150" dirty="0"/></a:p><a:p><a:pPr marL="0" indent="0"><a:lnSpc><a:spcPts val="1863"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1150" dirty="0"><a:solidFill><a:srgbClr val="555D66"/></a:solidFill><a:latin typeface="Arial" pitchFamily="34" charset="0"/><a:ea typeface="Arial" pitchFamily="34" charset="-122"/><a:cs typeface="Arial" pitchFamily="34" charset="-120"/></a:rPr><a:t>For this kind of business that is the only number that matters. Nobody researches a laptop repair for three weeks. Something breaks, they search, and they call whoever looks closest and most trustworthy.</a:t></a:r><a:endParaRPr lang="en-US" sz="1150" dirty="0"/></a:p><a:p><a:pPr marL="0" indent="0"><a:lnSpc><a:spcPts val="1863"/></a:lnSpc><a:buNone/></a:pPr><a:endParaRPr lang="en-US" sz="1150" dirty="0"/></a:p><a:p><a:pPr marL="0" indent="0"><a:lnSpc><a:spcPts val="1863"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1150" dirty="0"><a:solidFill><a:srgbClr val="555D66"/></a:solidFill><a:latin typeface="Arial" pitchFamily="34" charset="0"/><a:ea typeface="Arial" pitchFamily="34" charset="-122"/><a:cs typeface="Arial" pitchFamily="34" charset="-120"/></a:rPr><a:t>So the job was not to make the ads cheaper. It was to make the shop findable at the moment someone needed it.</a:t></a:r><a:endParaRPr lang="en-US" sz="1150" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="5" name="Shape 3"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="6172200" y="1005840"/><a:ext cx="8230" cy="4846320"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:solidFill><a:srgbClr val="E4E7EA"/></a:solidFill><a:ln w="12700"><a:solidFill><a:srgbClr val="E4E7EA"/></a:solidFill><a:prstDash val="solid"/></a:ln></p:spPr></p:sp><p:sp><p:nvSpPr><p:cNvPr id="6" name="Text 4"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="6583680" y="1005840"/><a:ext cx="3657600" cy="219456"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr marL="0" indent="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="950" dirty="0"><a:solidFill><a:srgbClr val="5A7D96"/></a:solidFill><a:latin typeface="Arial" pitchFamily="34" charset="0"/><a:ea typeface="Arial" pitchFamily="34" charset="-122"/><a:cs typeface="Arial" pitchFamily="34" charset="-120"/></a:rPr><a:t>What I did</a:t></a:r><a:endParaRPr lang="en-US" sz="950" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="7" name="Text 5"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="6583680" y="1463040"/><a:ext cx="274320" cy="256032"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr marL="0" indent="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1100" dirty="0"><a:solidFill><a:srgbClr val="8A929B"/></a:solidFill><a:latin typeface="Arial" pitchFamily="34" charset="0"/><a:ea typeface="Arial" pitchFamily="34" charset="-122"/><a:cs typeface="Arial" pitchFamily="34" charset="-120"/></a:rPr><a:t>1.</a:t></a:r><a:endParaRPr lang="en-US" sz="1100" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="8" name="Text 6"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="6876288" y="1463040"/><a:ext cx="4370832" cy="256032"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr marL="0" indent="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1150" b="1" dirty="0"><a:solidFill><a:srgbClr val="2B3138"/></a:solidFill><a:latin typeface="Arial" pitchFamily="34" charset="0"/><a:ea typeface="Arial" pitchFamily="34" charset="-122"/><a:cs typeface="Arial" pitchFamily="34" charset="-120"/></a:rPr><a:t>Connected the Business Profile</a:t></a:r><a:endParaRPr lang="en-US" sz="1150" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="9" name="Text 7"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="6876288" y="1737360"/><a:ext cx="4370832" cy="777240"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a